<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_visible_items = page.announcements.limit | default: 3 %}
    {% assign news_scrollable = false %}
    {% if include.limit and page.announcements.scrollable and news_size > news_visible_items %}
      {% assign news_scrollable = true %}
    {% endif %}
    <div
      class="table-responsive{% if news_scrollable %} news-scrollable{% endif %}"
      {% if news_scrollable %}
        style="--news-visible-items: {{ news_visible_items }}"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit and news_scrollable == false %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
